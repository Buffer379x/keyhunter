# Local development: copy to .env. No API secrets belong here.
# Use the actual UID/GID that own work/local/runtime/data.
KEYHUNTER_UID=1000
KEYHUNTER_GID=1000
KEYHUNTER_PORT=3000
KEYHUNTER_ORIGIN=http://localhost:3000
KEYHUNTER_ALLOW_INSECURE_HTTP=true
# NPM/LAN/VPN: set the real private HTTPS origin and false above.
# IGDB input file is work/local/igdb.env; Compose mounts it as a read-only secret.
# The app remains available without filled provider credentials.

# Daily product and discovery jobs per shop, 1–1000.
KEYHUNTER_SHOP_DAILY_JOBS=120
