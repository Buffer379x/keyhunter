# Local development: copy to .env. No API secrets belong here.
# Use the actual UID/GID that own work/local/runtime/data.
KEYHUNTER_UID=1000
KEYHUNTER_GID=1000
KEYHUNTER_PORT=3000
# Optional exact browser origin, e.g. https://keyhunter.example.
KEYHUNTER_ORIGIN=
KEYHUNTER_ALLOW_INSECURE_HTTP=true
# Use false to allow only HTTPS sign-ins and write requests.
# Configure IGDB from the signed-in application settings.

# Daily job budget per shop, a whole number from 1 to 2000 (default 500). A value set in the app under
# Settings / Key-Shops overrides it per shop. Every job counts, see docs/operations.md.
KEYHUNTER_SHOP_DAILY_JOBS=500

# Optional: IP or CIDR range of your reverse proxy (comma-separated). Only requests from there let the sign-in
# throttle count the client address from X-Forwarded-For. Leave empty without a proxy.
KEYHUNTER_TRUSTED_PROXY=

# Optional override for a pinned release or local build.
# KEYHUNTER_IMAGE=ghcr.io/buffer379x/keyhunter:0.5.0
