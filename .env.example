# Local development: copy to .env. No API secrets belong here.
# Use the actual UID/GID that own work/local/runtime/data.
KEYHUNTER_UID=1000
KEYHUNTER_GID=1000
KEYHUNTER_PORT=3000
# Optional exact browser origin, e.g. https://keyhunter.example.
KEYHUNTER_ORIGIN=
KEYHUNTER_ALLOW_INSECURE_HTTP=true
# Use false to allow only HTTPS sign-ins and write requests.
# Configure IGDB from the signed-in application settings.

# Daily product and discovery jobs per shop, 1–1000.
KEYHUNTER_SHOP_DAILY_JOBS=120

# Optional override for a pinned release or local build.
# KEYHUNTER_IMAGE=ghcr.io/buffer379x/keyhunter:0.4.1
